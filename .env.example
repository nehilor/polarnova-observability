################################################################################
# PolarNova Observability Platform — Environment Variables
#
# Copy this file to `.env` before deploying (Coolify can inject these too):
#   cp .env.example .env
#   ./scripts/generate-secrets.sh
#
# NEVER commit `.env` with real secrets.
################################################################################

# -----------------------------------------------------------------------------
# Deployment
# -----------------------------------------------------------------------------
DEPLOYMENT_ENVIRONMENT=production
COMPOSE_PROJECT_NAME=polarnova-observability

# Host identity attached to collector resource attributes
OTEL_HOST_NAME=polarnova-observability

# -----------------------------------------------------------------------------
# Image versions (pin for reproducible deploys; bump deliberately)
# -----------------------------------------------------------------------------
SIGNOZ_VERSION=v0.128.0
OTELCOL_VERSION=v0.144.5
CLICKHOUSE_VERSION=25.5.6
ZOOKEEPER_VERSION=3.7.1
UPTIME_KUMA_VERSION=1
NODE_EXPORTER_VERSION=v1.9.1
CADVISOR_VERSION=v0.52.1

# -----------------------------------------------------------------------------
# Secrets (REQUIRED) — generate with: ./scripts/generate-secrets.sh
# -----------------------------------------------------------------------------
# Used to sign SigNoz session JWTs. Rotate carefully (invalidates sessions).
SIGNOZ_JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# -----------------------------------------------------------------------------
# Published ports (Coolify maps domains → these)
# -----------------------------------------------------------------------------
# observe.polarnova.io  → SIGNOZ_HOST_PORT
SIGNOZ_HOST_PORT=8080

# uptime.polarnova.io    → UPTIME_KUMA_HOST_PORT
UPTIME_KUMA_HOST_PORT=3001

# otel.polarnova.io     → OTLP ports (gRPC + HTTP)
OTLP_GRPC_HOST_PORT=4317
OTLP_HTTP_HOST_PORT=4318

# -----------------------------------------------------------------------------
# Resource limits (tune to host size — production baseline assumes 16GB RAM)
# -----------------------------------------------------------------------------
CLICKHOUSE_CPU_LIMIT=4.00
CLICKHOUSE_MEMORY_LIMIT=8G

SIGNOZ_CPU_LIMIT=2.00
SIGNOZ_MEMORY_LIMIT=2G

OTEL_CPU_LIMIT=2.00
OTEL_MEMORY_LIMIT=2G

ZOOKEEPER_CPU_LIMIT=0.50
ZOOKEEPER_MEMORY_LIMIT=512M

UPTIME_CPU_LIMIT=1.00
UPTIME_MEMORY_LIMIT=512M

# -----------------------------------------------------------------------------
# Collector behaviour
# -----------------------------------------------------------------------------
# Group similar exceptions to reduce cardinality (recommended: false initially)
LOW_CARDINAL_EXCEPTION_GROUPING=false

# Enable DOT metrics in SigNoz
DOT_METRICS_ENABLED=true

# -----------------------------------------------------------------------------
# Public endpoints (documentation / app onboarding — not read by Compose)
# -----------------------------------------------------------------------------
PUBLIC_SIGNOZ_URL=https://observe.polarnova.io
PUBLIC_UPTIME_URL=https://uptime.polarnova.io
PUBLIC_OTLP_HTTP_ENDPOINT=https://otel.polarnova.io
PUBLIC_OTLP_GRPC_ENDPOINT=otel.polarnova.io:4317

# -----------------------------------------------------------------------------
# Backup
# -----------------------------------------------------------------------------
BACKUP_ROOT=/backups
BACKUP_RETENTION_DAYS=14
CLICKHOUSE_BACKUP_DATABASES=signoz_traces,signoz_metrics,signoz_logs,signoz_metadata,signoz_meter
