################################################################################
# PolarNova Observability — Environment Variables (Coolify)
#
# Copy placeholders into Coolify → Environment Variables.
# Generate secrets with: openssl rand -base64 48
#
# NEVER commit real secrets. NEVER use 0.0.0.0 for OTLP bind.
################################################################################

# -----------------------------------------------------------------------------
# Deployment identity
# -----------------------------------------------------------------------------
DEPLOYMENT_ENVIRONMENT=production
OTEL_HOST_NAME=polarnova-observability

# -----------------------------------------------------------------------------
# Pinned image versions (bump deliberately after backups)
# Aligned with SigNoz Foundry defaults around v0.134 / CH 25.12.5
# -----------------------------------------------------------------------------
IMAGE_SIGNOZ_TAG=v0.134.0
IMAGE_OTELCOL_TAG=v0.144.6
IMAGE_CLICKHOUSE_TAG=25.12.5
IMAGE_POSTGRES_TAG=16
IMAGE_UPTIME_KUMA_TAG=1.23.16

# -----------------------------------------------------------------------------
# REQUIRED secrets (placeholders only — replace in Coolify)
# -----------------------------------------------------------------------------
SIGNOZ_TOKENIZER_JWT_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_BASE64_48
POSTGRES_PASSWORD=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_BASE64_32

# PostgreSQL metastore (internal)
POSTGRES_DB=signoz
POSTGRES_USER=signoz

# -----------------------------------------------------------------------------
# Tailscale private OTLP (optional override compose / Coolify port binding)
# Set to this VPS Tailscale IPv4, e.g. 100.64.1.23 — NEVER 0.0.0.0
# Leave unset when using docker-compose.yml alone (Docker-network ingestion only)
# -----------------------------------------------------------------------------
# OTLP_BIND_HOST=100.x.x.x

# -----------------------------------------------------------------------------
# Resource limits (shared VPS — conservative defaults)
# -----------------------------------------------------------------------------
CLICKHOUSE_CPU_LIMIT=2.00
CLICKHOUSE_MEMORY_LIMIT=4G
KEEPER_CPU_LIMIT=0.50
KEEPER_MEMORY_LIMIT=512M
POSTGRES_CPU_LIMIT=0.50
POSTGRES_MEMORY_LIMIT=512M
SIGNOZ_CPU_LIMIT=1.00
SIGNOZ_MEMORY_LIMIT=1536M
OTEL_CPU_LIMIT=1.00
OTEL_MEMORY_LIMIT=1536M
UPTIME_CPU_LIMIT=0.50
UPTIME_MEMORY_LIMIT=384M

# -----------------------------------------------------------------------------
# Collector behaviour
# -----------------------------------------------------------------------------
LOW_CARDINAL_EXCEPTION_GROUPING=false
DOT_METRICS_ENABLED=true

# -----------------------------------------------------------------------------
# Retention (operational targets — configure also in SigNoz UI)
# Settings → Retention Period after first login
# -----------------------------------------------------------------------------
RETENTION_TRACES_DAYS=7
RETENTION_METRICS_DAYS=15
RETENTION_LOGS_DAYS=7

# -----------------------------------------------------------------------------
# Backup
# -----------------------------------------------------------------------------
BACKUP_ROOT=/var/backups/polarnova-observability
BACKUP_RETENTION_DAYS=14
CLICKHOUSE_BACKUP_DATABASES=signoz_traces,signoz_metrics,signoz_logs,signoz_metadata,signoz_meter

# -----------------------------------------------------------------------------
# Public / private endpoints (documentation only — not read by all services)
# -----------------------------------------------------------------------------
PUBLIC_SIGNOZ_URL=https://observe.polarnova.io
# Uptime domain — assign in Coolify ONLY after admin + auth configured
# PUBLIC_UPTIME_URL=https://uptime.polarnova.io
# Private OTLP examples (Tailscale):
#   http://100.x.x.x:4318
# Same Coolify/Docker network:
#   http://otel-collector:4318
